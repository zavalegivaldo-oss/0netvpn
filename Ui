<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">

<title>ZeroNet VPN</title>

<style>
:root{
  --bg:#000;
  --card:#0A0A1A;
  --red:#1565C0;
  --red-dark:#0A0E4A;
  --green:#10B981;
  --white:#FFF;
  --danger:#FF5555;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,Helvetica,sans-serif;
  -webkit-tap-highlight-color:transparent
}

body{
  background:var(--bg);
  color:var(--white);
  max-width:420px;
  margin:0 auto;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  position:relative;
  overflow-x:hidden
}

header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:10px 16px;
  background:#05050F;
  position:relative;
  z-index:5
}

.logo-box{
  background:#000;
  padding:6px 10px;
  border-radius:4px;
  border-bottom:3px solid var(--red)
}

.logo{
  font-size:22px;
  font-weight:900;
  letter-spacing:2px;
  line-height:1
}

.logo .accent{
  color:var(--red);
  font-size:26px;
  line-height:0
}

.logo-sub{
  font-size:9px;
  color:#aaa;
  margin-top:2px;
  letter-spacing:1px
}

.menu{
  width:28px;
  display:flex;
  flex-direction:column;
  gap:5px;
  cursor:pointer
}

.menu span{
  height:2px;
  background:var(--red);
  border-radius:2px
}

.screen{
  flex:1;
  overflow-y:auto;
  padding:16px 16px 80px
}

.top-select{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-bottom:20px
}

.select-card{
  background:var(--card);
  border-radius:10px;
  padding:12px 14px;
  border:1px solid var(--red-dark);
  cursor:pointer;
  border-top:2px solid var(--red)
}

.select-card label{
  font-size:11px;
  color:#7799CC;
  letter-spacing:1px;
  font-weight:700
}

.select-card .val{
  font-size:15px;
  color:var(--red);
  font-weight:900;
  margin-top:4px
}

.status{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  font-weight:900;
  font-size:13px;
  margin-bottom:16px;
  text-align:center;
  min-height:20px;
  letter-spacing:1px
}

.status-dot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:#555;
  flex-shrink:0
}

.status.connected{
  color:var(--green)
}

.status.connected .status-dot{
  background:var(--green)
}

.status.connecting .status-dot{
  background:var(--red);
  animation:blink 1s infinite
}

.status.error{
  color:#FF5555
}

.status.error .status-dot{
  background:#FF5555
}

@keyframes blink{
  50%{opacity:.3}
}

.btn-wrap{
  width:190px;
  height:190px;
  margin:0 auto 24px;
  position:relative
}

.btn-circle{
  width:190px;
  height:190px;
  border-radius:50%;
  position:absolute;
  top:0;
  left:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
  font-size:16px;
  color:var(--white);
  cursor:pointer;
  background:#0A0A1A;
  box-shadow:inset 0 0 0 8px #000;
  text-align:center;
  padding:0 20px;
  letter-spacing:2px
}

.btn-circle::before{
  content:'';
  position:absolute;
  width:148px;
  height:148px;
  border-radius:50%;
  background:#000;
  z-index:1
}

.btn-circle span{
  position:relative;
  z-index:2
}

.progress{
  position:absolute;
  top:0;
  left:0;
  width:190px;
  height:190px;
  transform:rotate(-90deg);
  z-index:3;
  pointer-events:none
}

.progress circle{
  fill:none;
  stroke-width:7;
  stroke-linecap:round
}

.progress .bg{
  stroke:#0A0A1A
}

.progress .bar{
  stroke:var(--red);
  stroke-dasharray:535;
  stroke-dashoffset:535;
  transition:stroke-dashoffset .1s linear
}

.progress.connected .bar{
  stroke:var(--green)
}

.stats-2{
  display:grid;
  grid-template-columns:1fr auto 1fr;
  gap:10px;
  align-items:center;
  margin-bottom:14px
}

.stat-box{
  background:var(--card);
  border:2px solid var(--red-dark);
  border-radius:10px;
  padding:14px;
  text-align:center;
  border-top:2px solid var(--red)
}

.stat-box .arrow{
  font-size:20px;
  color:var(--red);
  line-height:1;
  margin-bottom:4px
}

.stat-box.down .arrow{
  transform:rotate(180deg)
}

.stat-box .val{
  font-size:26px;
  font-weight:900;
  line-height:1
}

.stat-box .unit{
  font-size:11px;
  color:#7799CC;
  margin-left:2px
}

.stat-box .lbl{
  font-size:10px;
  color:#7799CC;
  margin-top:4px;
  font-weight:700;
  letter-spacing:1px
}

.refresh-btn{
  width:50px;
  height:50px;
  border-radius:50%;
  background:var(--red);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  font-weight:700;
  cursor:pointer
}

.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:10px
}

.card{
  background:var(--card);
  border-radius:10px;
  padding:13px;
  border:1px solid var(--red-dark);
  border-left:3px solid var(--red)
}

.card label{
  font-size:10px;
  color:#7799CC;
  font-weight:700;
  letter-spacing:.5px
}

.card .val{
  font-size:18px;
  font-weight:900;
  margin-top:4px
}

.graph-card{
  background:var(--card);
  border-radius:10px;
  padding:14px;
  border:1px solid var(--red-dark);
  border-left:3px solid var(--red);
  margin-bottom:10px
}

.graph-card label{
  font-size:10px;
  color:#7799CC;
  font-weight:700;
  letter-spacing:.5px;
  display:block;
  margin-bottom:8px
}

.graph-wrap{
  position:relative;
  width:100%;
  height:70px
}

#speedGraph{
  width:100%;
  height:70px;
  display:block
}

.graph-levels{
  position:absolute;
  top:0;
  right:0;
  height:100%;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  padding:2px 0
}

.graph-levels span{
  font-size:8px;
  color:#445577;
  font-weight:700
}

.banner{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  max-width:420px;
  margin:0 auto;
  background:var(--red);
  padding:14px;
  text-align:center;
  font-weight:900;
  font-size:12px;
  letter-spacing:1px;
  z-index:5
}

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.7);
  opacity:0;
  pointer-events:none;
  transition:opacity .25s;
  z-index:10
}

.overlay.open{
  opacity:1;
  pointer-events:auto
}

.drawer{
  position:fixed;
  top:0;
  left:0;
  height:100%;
  width:82%;
  max-width:330px;
  background:#05050F;
  border-right:2px solid var(--red-dark);
  transform:translateX(-100%);
  transition:transform .3s ease;
  z-index:11;
  display:flex;
  flex-direction:column
}

.drawer.open{
  transform:translateX(0)
}

.drawer-head{
  padding:18px 16px;
  border-bottom:1px solid var(--red-dark);
  display:flex;
  align-items:center;
  justify-content:space-between
}

.drawer-head .title{
  font-size:14px;
  font-weight:900;
  letter-spacing:2px;
  color:var(--red)
}

.close-x{
  font-size:24px;
  cursor:pointer;
  color:var(--white);
  line-height:1
}

.drawer-body{
  padding:12px 0;
  flex:1;
  overflow-y:auto
}

.drawer-item{
  padding:15px 20px;
  display:flex;
  align-items:center;
  gap:14px;
  font-size:13px;
  font-weight:700;
  cursor:pointer;
  border-bottom:1px solid #0a0a1a;
  color:var(--white);
  letter-spacing:.3px
}

.drawer-item:hover{
  background:#0A0A1A
}

.drawer-item .ico{
  font-size:10px;
  color:var(--red);
  width:34px;
  text-align:center;
  font-weight:900;
  letter-spacing:0;
  border:1px solid var(--red-dark);
  border-radius:4px;
  padding:4px;
  line-height:1.2;
  font-family:monospace;
  background:#060620
}

.drawer-item.highlight{
  background:linear-gradient(90deg,var(--red-dark),transparent);
  color:var(--white)
}

.drawer-item.new-feature{
  border-left:3px solid var(--red);
  background:linear-gradient(90deg,#0A0E4A,transparent)
}

.drawer-item.cancel-feature{
  border-left:3px solid var(--danger);
  background:linear-gradient(90deg,#2a0808,transparent)
}

.drawer-item.cancel-feature .ico{
  color:var(--danger);
  border-color:#5d0b0b
}

.drawer-foot{
  padding:14px 16px;
  border-top:1px solid var(--red-dark);
  font-size:10px;
  color:#445577;
  text-align:center
}

.modal-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.85);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:20;
  padding:20px
}

.modal-overlay.open{
  display:flex
}

.modal{
  background:#0A0A1A;
  border:2px solid var(--red);
  border-radius:16px;
  padding:24px 20px;
  max-width:340px;
  width:100%;
  text-align:center;
  animation:pop .2s ease;
  max-height:90vh;
  overflow-y:auto
}

@keyframes pop{
  from{
    transform:scale(.9);
    opacity:0
  }
  to{
    transform:scale(1);
    opacity:1
  }
}

.modal .ico-big{
  font-size:48px;
  margin-bottom:10px
}

.modal h3{
  font-size:18px;
  font-weight:900;
  margin-bottom:8px;
  color:var(--red)
}

.modal p{
  font-size:13px;
  color:#ddd;
  line-height:1.5;
  margin-bottom:18px
}

.modal .strong{
  color:var(--white);
  font-weight:900
}

.modal-btn{
  display:block;
  width:100%;
  padding:14px;
  border-radius:10px;
  background:var(--red);
  color:var(--white);
  font-weight:900;
  font-size:14px;
  text-decoration:none;
  border:none;
  cursor:pointer;
  letter-spacing:.5px;
  margin-bottom:8px
}

.modal-btn.ghost{
  background:transparent;
  border:1px solid #334;
  color:#aac
}

.modal-btn.danger{
  background:#8f1d1d;
  border:1px solid #ff5555;
  color:#fff
}

.sheet-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.6);
  opacity:0;
  pointer-events:none;
  transition:opacity .25s;
  z-index:15
}

.sheet-overlay.open{
  opacity:1;
  pointer-events:auto
}

.sheet{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  max-width:420px;
  margin:0 auto;
  background:#05050F;
  border-top:2px solid var(--red);
  border-radius:20px 20px 0 0;
  transform:translateY(100%);
  transition:transform .35s ease;
  z-index:16;
  max-height:92vh;
  overflow-y:auto;
  padding:20px
}

.sheet.open{
  transform:translateY(0)
}

.sheet-handle{
  width:50px;
  height:4px;
  background:#1a2244;
  border-radius:3px;
  margin:0 auto 16px
}

.sheet h2{
  color:var(--red);
  font-size:17px;
  font-weight:900;
  margin-bottom:6px;
  text-align:center;
  letter-spacing:1px
}

.sheet .sub{
  font-size:12px;
  color:#7799CC;
  text-align:center;
  margin-bottom:20px
}

.sheet .field{
  margin-bottom:14px
}

.sheet .field label{
  display:block;
  font-size:11px;
  color:#7799CC;
  font-weight:700;
  letter-spacing:1px;
  margin-bottom:6px
}

.sheet .field input{
  width:100%;
  background:#0A0A1A;
  border:1px solid var(--red-dark);
  color:var(--white);
  padding:14px;
  border-radius:10px;
  font-size:16px;
  font-weight:700;
  outline:none;
  text-transform:uppercase
}

.sheet .field input:focus{
  border-color:var(--red)
}

.primary-btn{
  width:100%;
  padding:15px;
  background:var(--red);
  color:#fff;
  font-weight:900;
  font-size:15px;
  border:none;
  border-radius:10px;
  cursor:pointer;
  letter-spacing:1px;
  margin-top:6px
}

.danger-btn{
  width:100%;
  padding:15px;
  background:#8f1d1d;
  color:#fff;
  font-weight:900;
  font-size:14px;
  border:1px solid var(--danger);
  border-radius:10px;
  cursor:pointer;
  letter-spacing:1px;
  margin-top:8px
}

.plan{
  background:#0A0A1A;
  border:2px solid var(--red-dark);
  border-radius:12px;
  padding:16px;
  margin-bottom:12px
}

.plan.featured{
  border-color:var(--red);
  background:linear-gradient(180deg,#0a0a2a,#0A0A1A)
}

.plan-head{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  margin-bottom:8px
}

.plan-name{
  font-weight:900;
  font-size:15px;
  color:var(--white)
}

.plan-price{
  font-weight:900;
  font-size:19px;
  color:var(--red)
}

.plan ul{
  list-style:none;
  padding:0;
  margin:0 0 12px 0
}

.plan ul li{
  font-size:12px;
  color:#aabbcc;
  padding:3px 0;
  padding-left:16px;
  position:relative
}

.plan ul li::before{
  content:'✓';
  color:var(--green);
  position:absolute;
  left:0;
  font-weight:900
}

.plan-btn{
  width:100%;
  padding:12px;
  background:var(--red);
  color:#fff;
  font-weight:900;
  border:none;
  border-radius:8px;
  cursor:pointer;
  letter-spacing:1px;
  font-size:13px
}

.checkout-frame{
  width:100%;
  height:65vh;
  border:none;
  border-radius:10px;
  background:#fff
}

.country-list,
.server-list{
  max-height:60vh;
  overflow-y:auto
}

.country-item{
  padding:13px;
  background:#0A0A1A;
  border:1px solid var(--red-dark);
  border-radius:8px;
  margin-bottom:8px;
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:12px;
  font-weight:700;
  font-size:14px
}

.country-item.active{
  border-color:var(--red);
  background:#0a0a2a
}

.first-notice{
  position:fixed;
  inset:0;
  background:#000;
  z-index:50;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px
}

.first-notice .box{
  background:#0A0A1A;
  border:2px solid var(--red);
  border-radius:16px;
  padding:28px 22px;
  max-width:360px;
  width:100%;
  text-align:center
}

.first-notice h2{
  color:var(--red);
  font-size:20px;
  font-weight:900;
  margin-bottom:14px
}

.first-notice p{
  font-size:13px;
  color:#ddd;
  line-height:1.6;
  margin-bottom:12px
}

.first-notice .warn{
  background:#000;
  border-left:3px solid var(--red);
  padding:10px;
  font-size:12px;
  color:#ccddff;
  text-align:left;
  margin:14px 0;
  border-radius:4px
}

.new-tab-header{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:18px
}

.back-btn{
  width:38px;
  height:38px;
  border-radius:9px;
  background:#0A0A1A;
  border:1px solid var(--red-dark);
  color:#fff;
  font-size:18px;
  font-weight:900;
  cursor:pointer
}

.new-tab-title{
  flex:1
}

.new-tab-title h2{
  font-size:17px;
  color:var(--red);
  font-weight:900;
  letter-spacing:1px
}

.new-tab-title p{
  font-size:10px;
  color:#7799CC;
  margin-top:3px
}

.feature-status{
  background:#0A0A1A;
  border:1px solid var(--red-dark);
  border-left:3px solid var(--red);
  border-radius:10px;
  padding:15px;
  margin-bottom:12px
}

.feature-status .row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:8px
}

.feature-status .row:last-child{
  margin-bottom:0
}

.feature-status label{
  color:#7799CC;
  font-size:10px;
  font-weight:700;
  letter-spacing:.7px
}

.feature-status strong{
  color:#fff;
  font-size:13px;
  text-align:right
}

.feature-status .active{
  color:var(--green)
}

.feature-status .inactive{
  color:var(--danger)
}

.net-unavailable{
  background:#0A0A1A;
  border:1px solid #321414;
  border-left:3px solid var(--danger);
  border-radius:12px;
  padding:20px 16px;
  text-align:center;
  margin-bottom:14px
}

.net-unavailable h3{
  color:var(--danger);
  font-size:16px;
  font-weight:900;
  margin-bottom:8px
}

.net-unavailable p{
  color:#aaa;
  font-size:12px;
  line-height:1.5;
  margin-bottom:16px
}

.access-card{
  background:#0A0A1A;
  border:2px solid var(--red-dark);
  border-radius:12px;
  padding:17px;
  margin-bottom:12px
}

.access-card.active{
  border-color:var(--green)
}

.access-card h3{
  color:#fff;
  font-size:15px;
  margin-bottom:13px
}

.access-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px
}

.access-info{
  background:#05050F;
  border:1px solid #111a3b;
  border-radius:8px;
  padding:10px
}

.access-info span{
  display:block;
  color:#667899;
  font-size:9px;
  font-weight:700;
  margin-bottom:4px
}

.access-info strong{
  display:block;
  color:#fff;
  font-size:12px;
  word-break:break-word
}

.expiry-box{
  margin-top:10px;
  padding:13px;
  background:#05050F;
  border:1px solid var(--red-dark);
  border-radius:9px;
  text-align:center
}

.expiry-box span{
  display:block;
  color:#7799CC;
  font-size:10px;
  margin-bottom:5px
}

.expiry-box strong{
  font-size:15px;
  color:#fff
}

.package-intro{
  background:#05050F;
  border:1px solid var(--red-dark);
  border-radius:10px;
  padding:14px;
  margin-bottom:12px
}

.package-intro h3{
  font-size:14px;
  color:#fff;
  margin-bottom:5px
}

.package-intro p{
  font-size:11px;
  color:#8999b5;
  line-height:1.5
}

.package-type{
  position:relative;
  background:#0A0A1A;
  border:2px solid var(--red-dark);
  border-radius:12px;
  padding:17px;
  margin-bottom:12px
}

.package-type.premium{
  border-color:var(--red)
}

.package-type h3{
  font-size:15px;
  color:#fff;
  margin-bottom:5px
}

.package-type .package-desc{
  font-size:11px;
  color:#7799CC;
  line-height:1.45;
  margin-bottom:12px
}

.package-type ul{
  list-style:none;
  margin-bottom:14px
}

.package-type li{
  font-size:11px;
  color:#b0bdd0;
  padding:4px 0;
  padding-left:15px;
  position:relative
}

.package-type li::before{
  content:'';
  position:absolute;
  left:0;
  top:9px;
  width:6px;
  height:6px;
  border-radius:50%;
  background:var(--green)
}

.package-label{
  position:absolute;
  right:12px;
  top:12px;
  font-size:8px;
  font-weight:900;
  color:var(--red);
  border:1px solid var(--red);
  padding:4px 6px;
  border-radius:4px;
  letter-spacing:.5px
}

.code-box{
  background:#0A0A1A;
  border:1px solid var(--red-dark);
  border-radius:12px;
  padding:18px;
  margin-bottom:12px
}

.code-box label{
  display:block;
  font-size:11px;
  color:#7799CC;
  font-weight:700;
  letter-spacing:1px;
  margin-bottom:8px
}

.code-input{
