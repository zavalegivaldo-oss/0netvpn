let partilhaCountdownTimer=null;

function startPartilhaCountdown(){

  if(partilhaCountdownTimer){
    clearInterval(partilhaCountdownTimer);
  }

  if(!partilhaAccess){
    return;
  }

  partilhaCountdownTimer=setInterval(()=>{

    if(!partilhaAccess){

      clearInterval(partilhaCountdownTimer);
      return;

    }

    const remaining=getRemainingTime();

    const element=
      document.getElementById(
        'partilhaCountdown'
      );

    if(!element){

      clearInterval(partilhaCountdownTimer);
      return;

    }

    if(remaining<=0){

      clearInterval(partilhaCountdownTimer);
      expirePartilhaAccess();
      return;

    }

    element.textContent=
      formatRemaining(remaining);

  },1000);

}

