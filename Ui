========================================================= */

function toggle(){

  if(estado==='conectando'){
    return;
  }

  if(estado==='conectado'){

    desconectar();
    return;

  }

  if(hasValidPartilhaAccess()){

    conectar(true);
    return;

  }

  if(user && user.approved){

    conectar(false);
    return;

  }

  openRegister();

}

function conectar(comCode=false){

  if(
    comCode &&
    !hasValidPartilhaAccess()
  ){

    openRegister();
    return;

  }

  if(
    !comCode &&
    !hasApprovedAccess()
  ){

    openRegister();
    return;

  }

  clearInterval(connectT);

  estado='conectando';

  document
    .getElementById('btnTxt')
    .textContent='CONECTANDO';

  const sr=
    document.getElementById('statusRow');

  sr.className='status connecting';

  document
    .getElementById('statusTxt')
    .textContent='CONECTANDO...';

  document
    .getElementById('progress')
    .classList
    .remove('connected');

  document
    .getElementById('bar')
    .style
    .strokeDashoffset=CIRC;

  document
    .getElementById('btnCircle')
    .style
    .background='#0A0A1A';

  let p=0;

  const usingCode=
    hasValidPartilhaAccess();

  const phases=
    usingCode
    ?[
      'Código aprovado...',
      'A validar acesso...',
      'A conectar ao servidor...'
    ]
    :[
      'Verificando número...',
      'Validando assinatura...',
      'Aguardando servidor...'
    ];

  document
    .getElementById('statusTxt')
    .textContent=phases[0];

  connectT=setInterval(()=>{

    p+=2;

    document
      .getElementById('bar')
      .style
      .strokeDashoffset=
        CIRC-(CIRC*p/100);

    if(p===20){

      document
        .getElementById('statusTxt')
        .textContent=phases[1];

    }

    if(p===38){

      document
        .getElementById('statusTxt')
        .textContent=phases[2];

    }

    if(p>=100){

      clearInterval(connectT);

      if(
        usingCode &&
        hasValidPartilhaAccess()
      ){

        concluirConexao();

        return;

      }

      if(
        user &&
        user.approved
      ){

        concluirConexao();

        return;

      }

      semConexao();

    }

  },45);

}

function concluirConexao(){

  estado='conectado';

  document
    .getElementById('progress')
    .classList
    .add('connected');

  document
    .getElementById('bar')
    .style
    .strokeDashoffset=0;

  document
    .getElementById('btnCircle')
    .style
    .background='#06150f';

  document
    .getElementById('btnTxt')
    .textContent='DESCONECTAR';

  const sr=
    document.getElementById('statusRow');

  sr.className='status connected';

  document
    .getElementById('statusTxt')
    .textContent='CONECTADO';

  document
    .getElementById('ipvpn')
    .textContent=
      '10.'+
      rand(10,99)+'.'+
      rand(1,254)+'.'+
      rand(1,254);

  document
    .getElementById('ping')
    .textContent=
      rand(20,85)+' ms';

  iniciarContadores();

}

function iniciarContadores(){

  clearInterval(loopT);

  loopT=setInterval(()=>{

    if(estado!=='conectado'){
      return;
    }

    seg++;

    const h=
      String(Math.floor(seg/3600))
      .padStart(2,'0');

    const m=
      String(Math.floor((seg%3600)/60))
      .padStart(2,'0');

    const s=
      String(seg%60)
      .padStart(2,'0');

    document
      .getElementById('tempo')
      .textContent=
        `${h}:${m}:${s}`;

    const downSpeed=
      rand(20,180);

    const upSpeed=
      rand(8,80);

    downKB+=downSpeed;
    upKB+=upSpeed;

    document
      .getElementById('downVal')
      .textContent=
        downKB>=1024
        ?(downKB/1024).toFixed(1)
        :downKB;

    document
      .getElementById('downUnit')
      .textContent=
        downKB>=1024?'MB':'KB';

    document
      .getElementById('upVal')
      .textContent=
        upKB>=1024
        ?(upKB/1024).toFixed(1)
        :upKB;

    document
      .getElementById('upUnit')
      .textContent=
        upKB>=1024?'MB':'KB';

    pushGraphPoint(
      Math.min(
        10,
        downSpeed/25
      )
    );

    document
      .getElementById('ping')
      .textContent=
        rand(20,85)+' ms';

  },1000);

}

