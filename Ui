function openPartilhaCheckout(type){

  const title=
    type==='premium'
    ?'PARTILHA NET PREMIUM'
    :'PARTILHA NET';

  const checkoutUrl=
    type==='premium'
    ?CHECKOUTS.premium
    :CHECKOUTS.mensal;

  openSheet(`

    <h2>${title}</h2>

    <div class="sub">
      Complete o pagamento abaixo
    </div>

    <iframe
      src="${checkoutUrl}"
      class="checkout-frame"
      allow="payment"
    ></iframe>

    <button
      class="primary-btn"
      style="background:transparent;border:1px solid #334;color:#aac;margin-top:12px"
      onclick="closeSheet()"
    >
      CANCELAR
    </button>

  `);

}

function formatActivationCode(){

  const input=
    document.getElementById(
      'activationCode'
    );

  if(!input){
    return;
  }

  let value=
    input.value
      .toUpperCase()
      .replace(/\s/g,'')
      .replace(/[^A-Z0-9]/g,'');

  if(value.length>6){
    value=value.substring(0,6);
  }

  input.value=value;

}

function validateActivationCode(code){

  const normalized=
    String(code||'')
      .trim()
      .toUpperCase();

  if(normalized.length!==6){

    return {
      valid:false,
      type:null,
      message:
        'O código deve possuir exatamente 6 caracteres.'
    };

  }

  if(normalized.includes('A')){

    return {
      valid:true,
      type:'weekly',
      message:'Código semanal aprovado.'
    };

  }

  if(normalized.includes('B')){

    return {
      valid:true,
      type:'daily',
      message:'Código diário aprovado.'
    };

  }

  return {
    valid:false,
    type:null,
    message:'Código não aprovado.'
  };

}

function confirmActivationCode(){

  const input=
    document.getElementById(
      'activationCode'
    );

  const validation=
    document.getElementById(
      'codeValidation'
    );

  if(!input||!validation){
    return;
  }

  const code=
    input.value
      .trim()
      .toUpperCase();

  const result=
    validateActivationCode(code);

  validation.className=
    'validation-box show '+
    (result.valid?'success':'error');

  validation.textContent=
    result.message;

  if(!result.valid){

    document
      .getElementById('codeConfirmation')
      .innerHTML='';

    return;

  }

  activatePartilhaCode(
    code,
    result.type
  );

}

function activatePartilhaCode(code,type){

  const now=Date.now();

  const duration=
    type==='weekly'
    ?7*24*60*60*1000
    :24*60*60*1000;

  const expiresAt=now+duration;

  partilhaAccess={
    code:code,
    type:type,
    server:selectedServer,
    country:COUNTRIES[selectedCountry].name,
    activatedAt:now,
    expiresAt:expiresAt,
    status:'Aprovado'
  };

  localStorage.setItem(
    PARTILHA_STORAGE_KEY,
    JSON.stringify(partilhaAccess)
  );

  updateBanner();

  renderCodeConfirmation();
  renderConnectionsPage();

}

function renderCodeConfirmation(){

  const container=
    document.getElementById(
      'codeConfirmation'
    );

  if(!container){
    return;
  }

  if(!partilhaAccess){

    container.innerHTML='';
    return;

  }

  container.innerHTML=`

    <div class="code-confirmed">

      <h3>
        Código aprovado
      </h3>

      <div class="confirm-row">
        <span>Servidor</span>
        <strong>
          ${partilhaAccess.server}
        </strong>
      </div>

      <div class="confirm-row">
        <span>Tipo de conexão</span>
        <strong>
          ${getCodeTypeLabel(partilhaAccess.type)}
        </strong>
      </div>

      <div class="confirm-row">
        <span>Estado</span>
        <strong style="color:#10B981">
          ACESSO APROVADO
        </strong>
      </div>

      <div class="confirm-row">
        <span>Código</span>
        <strong>
          ${partilhaAccess.code}
        </strong>
      </div>

      <div class="confirm-row">
        <span>Data de ativação</span>
        <strong>
          ${formatDateTime(partilhaAccess.activatedAt)}
        </strong>
      </div>

      <div class="confirm-row">
        <span>Data de expiração</span>
        <strong>
          ${formatDateTime(partilhaAccess.expiresAt)}
        </strong>
      </div>

      <div class="countdown">

        <small>TEMPO RESTANTE</small>

        <strong>
          ${formatRemaining(getRemainingTime())}
        </strong>

      </div>

    </div>

    <button
      class="primary-btn"
      onclick="showPage('vpnPage')"
    >
      IR PARA VPN E CONECTAR
    </button>

    <!-- NOVO: CANCELAR CÓDIGO -->
    <button
      class="danger-btn"
      onclick="openCancelAccess()"
    >
      CANCELAR CÓDIGO / INSCRIÇÃO
    </button>

  `;

}

function renderCodePage(){

  const input=
    document.getElementById(
      'activationCode'
    );

  if(input){
    input.value='';
  }

  const validation=
    document.getElementById(
      'codeValidation'
    );

  if(validation){

    validation.className=
      'validation-box';

    validation.textContent='';

  }

  renderCodeConfirmation();

}

setInterval(()=>{

  if(
    partilhaAccess &&
    Date.now()>=partilhaAccess.expiresAt
  ){

    expirePartilhaAccess();

    if(estado==='conectado'){

      desconectar();

    }

  }

},1000);

window.addEventListener('load',()=>{

  initGraph();

  if(
    partilhaAccess &&
    Date.now()>=partilhaAccess.expiresAt
  ){

    expirePartilhaAccess();

  }

  updateBanner();

});

</script>

