const graphCtx=
  graphCanvas.getContext('2d');

const MAX_POINTS=40;

let graphPoints=[];

function initGraph(){

  graphCanvas.width=
    graphCanvas.parentElement.clientWidth-40;

  graphCanvas.height=70;

  graphPoints=[];

  for(
    let i=0;
    i<MAX_POINTS;
    i++
  ){
    graphPoints.push(0);
  }

  drawGraph();

}

function drawGraph(){

  const w=graphCanvas.width;
  const h=graphCanvas.height;

  graphCtx.clearRect(0,0,w,h);

  const levels=[0,2,5,7,10];

  levels.forEach(lv=>{

    const y=h-(lv/10)*h;

    graphCtx.beginPath();
    graphCtx.strokeStyle='#0a1030';
    graphCtx.lineWidth=1;
    graphCtx.setLineDash([3,4]);
    graphCtx.moveTo(0,y);
    graphCtx.lineTo(w,y);
    graphCtx.stroke();

  });

  graphCtx.setLineDash([]);

  graphCtx.beginPath();

  const step=w/(MAX_POINTS-1);

  graphPoints.forEach((v,i)=>{

    const x=i*step;
    const y=h-(v/10)*h;

    if(i===0){
      graphCtx.moveTo(x,y);
    }else{
      graphCtx.lineTo(x,y);
    }

  });

  graphCtx.lineTo(w,h);
  graphCtx.lineTo(0,h);
  graphCtx.closePath();

  graphCtx.fillStyle='rgba(21,101,192,0.18)';
  graphCtx.fill();

  graphCtx.beginPath();

  graphPoints.forEach((v,i)=>{

    const x=i*step;
    const y=h-(v/10)*h;

    if(i===0){
      graphCtx.moveTo(x,y);
    }else{
      graphCtx.lineTo(x,y);
    }

  });

  graphCtx.strokeStyle='#1565C0';
  graphCtx.lineWidth=2;
  graphCtx.stroke();

}

function pushGraphPoint(val){

  graphPoints.shift();
  graphPoints.push(Math.min(val,10));

  drawGraph();

}

window.addEventListener('resize',()=>{

  graphCanvas.width=
    graphCanvas.parentElement.clientWidth-40;

  drawGraph();

});

